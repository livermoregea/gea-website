NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Groq credentials for PEET task scoring.
GROQ_API_KEY=
# Current shared default for website and Discord task reviews.
GROQ_PEET_MODEL=openai/gpt-oss-120b

# Server-only scheduler bearer secret; configure this in Vercel too.
CRON_SECRET=

# Discord: server-only credentials. See docs/discord.md.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Private reviewer channel (bot needs View Channel and Send Messages).
DISCORD_REVIEW_CHANNEL_ID=
# Shared notices channel for generic alerts when DMs fail or accounts are unlinked.
DISCORD_NOTICES_CHANNEL_ID=
# Public website origin; adds a website button to fallback notices.
NEXT_PUBLIC_SITE_URL=
DISCORD_WEBHOOK_TASKS=
DISCORD_WEBHOOK_ATTENDANCE=
DISCORD_WEBHOOK_ANNOUNCEMENTS=

# Optional officer task channels: use channel IDs, not webhook URLs.
# Unmapped positions fall back to DISCORD_WEBHOOK_TASKS.

# President channel also receives notice delivery/fallback and response updates.
DISCORD_CHANNEL_PRESIDENT=
DISCORD_CHANNEL_VICE_PRESIDENT=
DISCORD_CHANNEL_SECRETARY=
DISCORD_CHANNEL_PUBLICIST=
DISCORD_CHANNEL_TREASURER=
DISCORD_CHANNEL_REPS=
# Optional separate grade channels; otherwise both use DISCORD_CHANNEL_REPS.
DISCORD_CHANNEL_REP_9=
DISCORD_CHANNEL_REP_10=

# Optional matching role pings in officer channels (role IDs, not channel IDs).
DISCORD_ROLE_PRESIDENT=
DISCORD_ROLE_VICE_PRESIDENT=
DISCORD_ROLE_SECRETARY=
DISCORD_ROLE_PUBLICIST=
DISCORD_ROLE_TREASURER=
DISCORD_ROLE_REPS=
DISCORD_ROLE_REP_9=
DISCORD_ROLE_REP_10=
# Shared secretary/reviewer attendance overview; defaults to off.
DISCORD_ATTENDANCE_OVERVIEW=false
